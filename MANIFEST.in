include README.md LICENSE NOTICE GOLDEN_SOURCE.json
include CHANGELOG.md DISCLAIMER.md SECURITY.md THIRD_PARTY_NOTICES.md
recursive-include LICENSES *.txt
include THIRD_PARTY_DATA_REGISTER.json
